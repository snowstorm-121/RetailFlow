  {
    "type": "function",
    "function": {
      "name": "cancel_pending_order",
      "description": "Stage a cancellation proposal for the authenticated user's pending order. The first call does NOT cancel; it returns a proposal for the application to confirm. Preserve the leading # in the order ID. Reason must be 'ordered by mistake' or 'no longer needed'.",
      "parameters": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "pattern": "^#W[0-9]+$"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "order_id",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "return_delivered_order_items",
      "description": "Stage a return proposal for selected item IDs in the authenticated user's delivered order. The first call does NOT return items; it creates an application confirmation proposal. Preserve the leading # in the order ID.",
      "parameters": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "pattern": "^#W[0-9]+$"
          },
          "item_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "payment_method_id": {
            "type": "string"
          }
        },
        "required": [
          "order_id",
          "item_ids",
          "payment_method_id"
        ],
        "additionalProperties": false
      }
    }
  },
